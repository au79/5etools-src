{
  "name": "5etools-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server package for the local 5etools data repository.",
  "engines": {
    "node": ">=24",
    "pnpm": "11.17.0"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json && node scripts/write-build-metadata.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "start": "node dist/src/cli.js",
    "validate:data": "pnpm run build && node dist/src/validationCli.js",
    "smoke:stdio": "pnpm run build && node scripts/smoke-stdio.mjs",
    "codex:tunnel:client": "bash scripts/tunnel-client.sh",
    "codex:tunnel:doctor": "bash scripts/tunnel-client.sh doctor --profile 5etools-local --explain",
    "codex:tunnel:init": "pnpm run build && bash scripts/tunnel-client.sh init-5etools",
    "codex:tunnel:run": "bash scripts/tunnel-client.sh run --profile 5etools-local --watch",
    "test": "pnpm run build && node --test dist/src/*.test.js",
    "test:coverage": "pnpm run build && node --experimental-test-coverage --test-coverage-include='dist/src/**/*.js' --test-coverage-exclude='dist/src/*.test.js' --test-coverage-exclude='dist/src/cli.js' --test-coverage-exclude='dist/src/validationCli.js' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test dist/src/*.test.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jsonc-parser": "^3.3.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  }
}
